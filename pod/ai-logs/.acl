@prefix acl: <http://www.w3.org/ns/auth/acl#>.

<#ownerFullControl>
    a acl:Authorization;
    acl:agent <https://solid-virid.vercel.app/profile/card.ttl#me>;
    acl:accessTo <https://solid-virid.vercel.app/pod/ai-logs/>;
    acl:default <https://solid-virid.vercel.app/pod/ai-logs/>;
    acl:mode acl:Read, acl:Write, acl:Control.

<#aiProcessorAppendOnly>
    a acl:Authorization;
    acl:agent <http://localhost:11434/profile/card#mistral>;
    acl:accessTo <https://solid-virid.vercel.app/pod/ai-logs/>;
    acl:default <https://solid-virid.vercel.app/pod/ai-logs/>;
    acl:mode acl:Append.
